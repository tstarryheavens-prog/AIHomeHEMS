# はてなブログ AtomPub API 設定ファイル
# このファイルをコピーして `.env` を作成してください。
# cp .env.example .env

# はてなID（ユーザー名）
HATENA_ID=your_hatena_id

# ブログID（ブログのURLドメイン。例: example.hatenablog.com）
HATENA_BLOG_ID=your_blog_id.hatenablog.com

# AtomPub APIキー
# 取得方法: はてなブログ管理画面 > [設定] > [詳細設定] > [AtomPub APIキー]
HATENA_API_KEY=your_atompub_api_key

# 投稿のデフォルト設定 (true: 下書き保存, false: 即時公開)
HATENA_DEFAULT_DRAFT=true
